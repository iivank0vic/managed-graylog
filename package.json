{
  "name": "managed-graylog-site",
  "private": true,
  "description": "managed-graylog.com website — build tooling only (the site itself is PHP + static assets).",
  "scripts": {
    "build:css": "sass --no-source-map --style=compressed --quiet-deps --silence-deprecation=import,global-builtin,color-functions,mixed-decls src/scss/site.scss assets/css/site.min.css",
    "watch:css": "sass --watch --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,mixed-decls src/scss/site.scss assets/css/site.min.css",
    "build:icons": "node bin/build-icons.mjs node_modules/lucide-static/icons",
    "build": "npm run build:css && php bin/build-sitemap.php",
    "serve": "php -S 127.0.0.1:8080 bin/router.php"
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "lucide-static": "^1.47.0",
    "sass": "^1.80.0"
  }
}
